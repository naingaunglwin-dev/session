{
  "name": "naingaunglwin-dev/session",
  "description": "Simple PHP Session Library",
  "minimum-stability": "dev",
  "version": "1.0.0",
  "prefer-stable": true,
  "license": "MIT",
  "authors": [
    {
      "name": "naingaunglwin-dev",
      "email": "naingaunglwin.wd@gmail.com"
    }
  ],
  "require": {
    "php": "^8.4"
  },
  "autoload": {
    "psr-4": {
      "Naingaunglwin\\Session\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "pestphp/pest": "^4.3"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
